    stroke-width: 4
    font-size: 20
    stroke-dash: 5
  }
}
oversight_middleware.proxy_gateway -> oversight_middleware.nats_queue: "Publishes manual UI\nintents & JWTs" {
  style: {stroke-width: 4; font-size: 20; stroke: "#3498db"}
}
oversight_middleware.nats_queue -> oversight_middleware.l15_zone.l15_arbitrator: "Consumes the proposals" {
  style: {
    stroke-width: 4
    font-size: 20
    stroke: "#3498db"
  }
}
oversight_middleware.l15_zone.l15_arbitrator -> oversight_middleware.ui_app: "Asserts interactive Two-Key prompts" {
