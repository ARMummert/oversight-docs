vars: {
  d2-config: {
    theme-id: 300
    layout-engine: elk
  }
}

direction: right

oversight: Oversight Service

breaker: NATS Circuit Breaker {
  closed: CLOSED
  open: OPEN
  half_open: HALF_OPEN
}

nats: NATS / JetStream

oversight -> breaker.closed: NATS operation
breaker.closed -> nats: Publish / consume

nats -> breaker.closed: Normal operation success

breaker.closed -> breaker.open: Failure threshold reached
breaker.open -> oversight: Fail fast\nEnter degraded mode

breaker.open -> breaker.half_open: Reset timeout expires

breaker.half_open -> nats: Limited recovery attempt
nats -> breaker.half_open: Recovery verification success
breaker.half_open -> breaker.closed: Recovery successful

nats -> breaker.half_open: Recovery verification failure
breaker.half_open -> breaker.open: Recovery failed