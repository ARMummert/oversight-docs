direction: down
title: |md
  # Container View: Air-Gapped Pure Event-Driven Architecture with Integrated Observability
|
vars: {
  d2-config: {
    theme-id: 1
    layout-engine: elk
  }
}
classes: {
  container: { style: { fill: "#438dd5"; font-color: white; border-radius: 5 } }
  db: { shape: cylinder; style: { fill: "#2b5c8f"; font-color: white } }
  broker: { shape: queue; style: { fill: "#28a745"; font-color: white } }
  observability: { style: { fill: "#e83e8c"; font-color: white; border-radius: 5 } }
  boundary: { style: { fill: transparent; stroke-dash: 5; stroke-width: 2 } }
}

# UI Footprint (User Interaction Plane)
web_ui: Dashboard {
  description: "Single Page Application rendering real-time streaming state changes and managing user token injection."
  style: { fill: "#083f72"; font-color: white }
}

# Downstream Infrastructure Target (LAN Boundary)
field_assets: Physical Field Assets & Sensors {
  shape: rectangle
  description: "Downstream local machinery streaming raw metric bytes and executing discrete state-mutation directives."
}

# Monolithic Edge Server Boundary (100% Isolated Host Runtime)
edge_compute_node: Edge Gateway Host Runtime {
  class: boundary

  api_gateway: API Gateway (Nginx) {
    class: container
    description: "TLS Termination, JWT cryptographic validation, and high-concurrency request rate limiting."
  }

  # ==========================================
  # THE READ PATH (Telemetry Ingestion & Cache)
  # ==========================================
  ingest_service: Northbound Ingestion Microservice {
    class: container
    description: "A custom microservice that binds to the private Northbound NIC,\n polls raw telemetry, maps telemetry to a JSON UNS schema,\n and streams it into the NATS JetStream Command Queue"  }

  event_bus: NATS JetStream (Event Spine) {
    class: broker
    description: "High-throughput append-only log handling telemetry streams,\n unvetted intents, and verified execution queues."
  }

  stream_processor: Bytewax Stream Processor {
    class: container
    description: "Python-native stream processing engine executing sliding-window statistical calculations (Z-scores)."
  }

  cache: Redis Hot Cache {
    class: db
    description: "In-memory volatile state cache driving sub-millisecond, push-based WebSocket updates directly to the Web UI."
  }

  # ==========================================
  # DURABLE SYSTEM OF RECORD
  # ==========================================
  state_db: PostgreSQL / TimescaleDB {
    class: db
    description: "Durable System of Record for time-series hypertables, system configurations, and immutable audit logs."
  }

  vector_db: pgvector Extension {
    class: db
    description: "Houses local 384-dimensional document embeddings for grounding agent retrieval tasks."
  }

  # ==========================================
  # THE WRITE PATH (Cognitive Reasoning Plane)
  # ==========================================
  orchestrator: Cognitive Orchestrator (LangGraph) {
    class: container
    description: "State-machine managing local context hydration, data lookups, and step-by-step reasoning tokens."
  }

  inference_service: Ollama LLM Engine {
    class: container
    description: "Isolated container running local phi-4 weights. Restricts generation format via Guided Decoding / JSON Mode."
  }

  policy_engine: Policy Validator / Gatekeeper {
    class: container
    description: "Hardcoded programmatic validation engine. Rejects out-of-bounds payloads generated by the LLM."
  }

  execution_adapter: Hardware Execution Adapter {
    class: container
    description: "Decoupled worker consuming verified command streams from NATS and compiling them into physical write mutations."
  }

  # ==========================================
  # THE OBSERVABILITY STACK
  # ==========================================
  prometheus: Prometheus Server {
    class: observability
    description: "Time-series database pulling app performance metrics and hardware health profiles via pull-based scraping."
  }

  grafana: Grafana Dashboard {
    class: observability
    description: "Visualization server rendering diagnostic UI grids, container performance matrices, and system health status maps."
  }
}

# READ PATH DATA FLOWS (High-Velocity Event Stream)
field_assets -> edge_compute_node.ingest_service: "Raw Packet Payloads"
edge_compute_node.ingest_service -> edge_compute_node.event_bus: "Publishes Normalized Namespace Events"
edge_compute_node.event_bus -> edge_compute_node.stream_processor: "Consumes telemetry event queue stream"
edge_compute_node.stream_processor -> edge_compute_node.state_db: "Persists calculated Z-scores to hyper-tables"
edge_compute_node.stream_processor -> edge_compute_node.cache: "Hydrates live state indicators"

# WRITE PATH DATA FLOWS (Pessimistic Verification Engine via NATS Pipeline)
web_ui -> edge_compute_node.api_gateway: "Operator submits verified intent [HTTPS/JWT]"
edge_compute_node.api_gateway -> edge_compute_node.state_db: "Commits user token signature to immutable audit logs"
edge_compute_node.orchestrator -> edge_compute_node.vector_db: "Queries pgvector for design criteria grounding"
edge_compute_node.orchestrator -> edge_compute_node.inference_service: "Invokes local inference path [REST / JSON Schema]"
edge_compute_node.inference_service -> edge_compute_node.orchestrator: "Returns structurally validated mitigation schema string"
edge_compute_node.orchestrator -> edge_compute_node.event_bus: "Publishes unvetted intent strategy event"
edge_compute_node.event_bus -> edge_compute_node.policy_engine: "Consumes unvetted payload for boundary checking"
edge_compute_node.policy_engine -> edge_compute_node.event_bus: "Publishes verified payloads to command stream"
edge_compute_node.event_bus -> edge_compute_node.execution_adapter: "Delivers verified directives via exactly-once queue consumer"
edge_compute_node.execution_adapter -> field_assets: "Commits signed discrete state-mutation directive"

# OBSERVABILITY PIPELINE FLOWS
edge_compute_node.prometheus -> edge_compute_node.api_gateway: "Scrapes API request/error counts [/metrics]"
edge_compute_node.prometheus -> edge_compute_node.stream_processor: "Scrapes stateful windowing pipeline latency [/metrics]"
edge_compute_node.prometheus -> edge_compute_node.orchestrator: "Scrapes LangGraph step-duration and routing traces"
edge_compute_node.prometheus -> edge_compute_node.inference_service: "Scrapes token-generation speed & queue status"
edge_compute_node.grafana -> edge_compute_node.prometheus: "Queries collected operational time-series parameters"
web_ui -> edge_compute_node.grafana: "Provides iframe-embedded telemetry diagnostic cards directly to users"

# UI REAL-TIME ACCESS PIPELINE
web_ui -> edge_compute_node.cache: "Subscribes to live process views [WSS]"